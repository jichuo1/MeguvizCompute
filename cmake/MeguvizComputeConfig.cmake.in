@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(MeguvizCompute_PRIVATE_SDK_FINGERPRINT "@MGC_PRIVATE_FINGERPRINT@")
if(DEFINED MGC_REQUIRED_PRIVATE_SDK_FINGERPRINT AND NOT MGC_REQUIRED_PRIVATE_SDK_FINGERPRINT STREQUAL MeguvizCompute_PRIVATE_SDK_FINGERPRINT)
  message(FATAL_ERROR "MeguvizCompute private SDK fingerprint mismatch")
endif()
if(@MGC_WITH_NCNN@)
  if(TARGET ncnn)
    get_target_property(existing_owner ncnn MGC_COMPUTE_PRIVATE_SDK)
    if(NOT existing_owner STREQUAL MeguvizCompute_PRIVATE_SDK_FINGERPRINT)
      message(FATAL_ERROR "Preexisting ncnn target is not owned by the required Compute private SDK")
    endif()
  else()
    find_dependency(ncnn 20261020 EXACT CONFIG)
    set_property(TARGET ncnn PROPERTY MGC_COMPUTE_PRIVATE_SDK "${MeguvizCompute_PRIVATE_SDK_FINGERPRINT}")
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MeguvizComputeTargets.cmake")
check_required_components(MeguvizCompute)
