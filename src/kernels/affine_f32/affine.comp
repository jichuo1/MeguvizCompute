#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) readonly buffer Input { float values[]; } input_data;
layout(set=0,binding=1) writeonly buffer Output { float values[]; } output_data;
layout(push_constant) uniform parameter { uint count; float scale; float bias; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.count)output_data.values[i]=input_data.values[i]*p.scale+p.bias;}
