{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meguviz:shaderpack:0.1",
  "title": "Meguviz shaderpack contract 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "abi_version",
    "profile_id",
    "profile_version",
    "required_flags",
    "source_closure_hash",
    "toolchain_lock_hash",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "abi_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profile_id": {
      "enum": [
        "ncnn-compat",
        "native-vulkan"
      ]
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "required_flags": {
      "type": "array",
      "maxItems": 0
    },
    "source_closure_hash": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_lock_hash": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_shader_id",
        "variant_key",
        "spirv_path",
        "spirv_sha256",
        "spirv_size",
        "entry_point",
        "target_env",
        "effective_options_hash",
        "layout_abi",
        "required_caps"
      ],
      "properties": {
        "logical_shader_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "variant_key": {
          "$ref": "#/$defs/sha256"
        },
        "spirv_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
        },
        "spirv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spirv_size": {
          "type": "integer",
          "minimum": 20,
          "maximum": 67108864
        },
        "entry_point": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "target_env": {
          "type": "string",
          "minLength": 1
        },
        "effective_options_hash": {
          "$ref": "#/$defs/sha256"
        },
        "layout_abi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descriptor_sets",
            "push_constants",
            "specialization_constants",
            "local_size"
          ],
          "properties": {
            "descriptor_sets": {
              "type": "array"
            },
            "push_constants": {
              "type": "array"
            },
            "specialization_constants": {
              "type": "array"
            },
            "local_size": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required_caps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reflection_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
        },
        "reflection_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
